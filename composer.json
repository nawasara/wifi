{
    "name": "nawasara/wifi",
    "description": "Public WiFi hotspot monitoring for the Nawasara superapp framework — hotspot registry with location coordinates and connection status, ready for map plotting.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "nawasara",
        "laravel",
        "wifi",
        "hotspot",
        "monitoring",
        "public-infrastructure"
    ],
    "authors": [
        {
            "name": "Pringgo J. Saputro",
            "email": "odyinggo@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nawasara/wifi/issues",
        "source": "https://github.com/nawasara/wifi"
    },
    "autoload": {
        "psr-4": {
            "Nawasara\\Wifi\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^12.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.0",
        "nawasara/ui": "*",
        "livewire/livewire": "^3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nawasara\\Wifi\\WifiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
